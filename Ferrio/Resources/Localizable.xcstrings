    "ai-content-message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The description of this holiday was generated by artificial intelligence, based on publicly available sources.\n\nIt has not been written by a human editor and may contain inaccuracies. Verify important facts in other sources before relying on them.\n\nIf you spot a mistake, report it – every report is reviewed by a moderator."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opis tego święta został wygenerowany przez sztuczną inteligencję na podstawie ogólnodostępnych źródeł.\n\nNie napisał go człowiek i może zawierać nieścisłości. Ważne fakty warto zweryfikować w innych źródłach.\n\nJeśli zauważysz błąd, zgłoś go – każde zgłoszenie trafia do moderatora."
          }
        }
      }
    },
