    "report-notice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanks for helping the calendar grow! Every submission is reviewed by hand, so please keep it meaningful - spam, submissions without substantive content, and duplicate or repeated submissions may be removed without prior notice. Thank you for your understanding and for making the app better!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziękujemy, że pomagasz rozwijać kalendarz! Każde zgłoszenie sprawdzamy ręcznie, dlatego prosimy o wartościowe treści - spam, zgłoszenia niemające merytorycznej treści oraz powtarzające się lub zduplikowane mogą zostać usunięte bez wcześniejszego ostrzeżenia. Dziękujemy za zrozumienie i pomoc w ulepszaniu aplikacji!"
          }
        }
      }
    },
